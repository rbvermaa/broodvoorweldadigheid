<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for `make backup-schedule`, which fills in the @...@ values. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.broodvoorweldadigheid.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>@MAKE@</string>
    <string>--no-print-directory</string>
    <string>-C</string>
    <string>@REPO@</string>
    <string>backup</string>
    <string>BVW_BACKUP_DIR=@BACKUP_DIR@</string>
    <string>COMPOSE_PROJECT=@PROJECT@</string>
    <string>BVW_IMAGE_TAG=@IMAGE_TAG@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
