  "query": "SELECT p.id, p.title, p.bake_day_id,\n            d.date - date 'epoch' AS bake_date_days,\n            (extract(epoch FROM p.closes_at) * 1000000)::bigint AS \"closes_us!\",\n            p.public_results\n        FROM poll p LEFT JOIN bake_day d ON d.id = p.bake_day_id\n        WHERE p.id = $1",
