  "query": "SELECT l.order_id, p.name_nl, l.qty, l.unit_price_cents, l.vat_rate\n        FROM order_line l\n        JOIN \"order\" o ON o.id = l.order_id\n        JOIN product p ON p.id = l.product_id\n        WHERE o.customer_id = $1\n        ORDER BY l.id",
