  "query": "SELECT o.id, o.name,\n            count(v.id) FILTER (WHERE v.confirmed_at IS NOT NULL) AS \"votes!\"\n        FROM poll_option o LEFT JOIN vote v ON v.poll_option_id = o.id\n        WHERE o.poll_id = $1\n        GROUP BY o.id ORDER BY o.position",
