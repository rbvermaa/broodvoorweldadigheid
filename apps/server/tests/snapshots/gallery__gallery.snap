<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Componenten · Brood voor Weldadigheid</title>
<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0}'>
<meta name="csrf-token" content="test-token">
<link rel="stylesheet" href="/static/fonts.css?v=HASH">
<link rel="stylesheet" href="/static/tokens.css?v=HASH">
<link rel="stylesheet" href="/static/app.css?v=HASH">
<link rel="stylesheet" href="/static/components.css?v=HASH">
<script src="/static/htmx.min.js?v=HASH" defer></script>
<script src="/static/app.js?v=HASH" defer></script>
</head>
<body>
<a class="skip-link" href="#inhoud">Naar de inhoud</a>
<header class="site-header">
<a class="site-name" href="/">Brood voor Weldadigheid</a>
</header>
<main id="inhoud" class="site-main">

<h1>Componenten</h1>
<p>Elke component in elke toestand: normaal, uitgeschakeld, fout, leeg en met lange woorden.</p>

<section class="gallery-section" aria-labelledby="gallery-buttons">
<h2 id="gallery-buttons">Knoppen</h2>
<div class="gallery-row">

<button type="button" class="button button-primary"><span class="button-label">Opslaan</span></button>


<button type="button" class="button button-secondary"><span class="button-label">Terug</span></button>


<button type="button" class="button button-danger"><span class="button-label">Bakdag annuleren</span></button>


<button type="button" class="button button-primary" disabled><span class="button-label">Niet beschikbaar</span></button>


<button type="button" class="button button-secondary" disabled><span class="button-label">Niet beschikbaar</span></button>


<button type="button" class="button button-primary" disabled aria-busy="true"><span class="button-spinner"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" role="img" aria-label="Bezig…"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg></span><span class="button-label">Opslaan</span></button>


<button type="button" class="button button-primary"><span class="button-label">Ophaalmomentvoorkeursinstellingen opslaan</span></button>

</div>
</section>

<section class="gallery-section" aria-labelledby="gallery-fields">
<h2 id="gallery-fields">Formuliervelden</h2>
<div class="gallery-form">

<div class="field">

<label class="field-label" for="naam">Naam <span class="field-required" aria-hidden="true">(verplicht)</span></label>

<p class="field-hint" id="naam-hint">Zoals op je bestelling komt te staan.</p>

<input class="field-input" type="text" id="naam" name="naam" value="" aria-describedby="naam-hint" required>
</div>


<div class="field field-invalid">

<label class="field-label" for="email">E-mailadres <span class="field-required" aria-hidden="true">(verplicht)</span></label>

<p class="field-error" id="email-error"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg><span class="visually-hidden">Fout:</span> Vul een geldig e-mailadres in, zoals naam@voorbeeld.nl.</p>

<input class="field-input" type="email" id="email" name="email" value="naam@" aria-describedby="email-error" aria-invalid="true" required>
</div>


<div class="field field-invalid">

<label class="field-label" for="aantal">Aantal broden</label>

<p class="field-error" id="aantal-error"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg><span class="visually-hidden">Fout:</span> Kies minstens 1 brood.</p>

<input class="field-input field-input-number" type="number" inputmode="numeric" id="aantal" name="aantal" value="0" aria-describedby="aantal-error" aria-invalid="true">
</div>


<div class="field">

<label class="field-label" for="prijs">Prijs <span class="visually-hidden">in euro</span></label>

<p class="field-hint" id="prijs-hint">Inclusief btw.</p>

<div class="field-money"><span class="field-prefix" aria-hidden="true">€</span><input class="field-input" type="text" inputmode="decimal" autocomplete="off" id="prijs" name="prijs" value="4,50" aria-describedby="prijs-hint"></div>
</div>


<div class="field">

<label class="field-label" for="opmerking">Opmerking</label>

<p class="field-hint" id="opmerking-hint">Bijvoorbeeld: graag gesneden.</p>

<textarea class="field-input" id="opmerking" name="opmerking" rows="3" aria-describedby="opmerking-hint"></textarea>
</div>


<div class="field">

<label class="field-label" for="lang">Zuurdesemvolkorenbrood met zonnebloempitten</label>



<input class="field-input" type="text" id="lang" name="lang" value="Zuurdesemvolkorenbrood met zonnebloempitten">
</div>


<div class="field">

<label class="field-label" for="uit">Uitgeschakeld veld</label>



<input class="field-input" type="text" id="uit" name="uit" value="Niet beschikbaar" disabled>
</div>


<div class="field">

<label class="field-label" for="doel">Goed doel <span class="field-required" aria-hidden="true">(verplicht)</span></label>



<select class="field-input" id="doel" name="doel" required>
<option value="">Kies…</option>
<option value="voedselbank">Voedselbank Westerveld</option>
<option value="kinderhulp" selected>Stichting Kinderhulp Frederiksoord</option>
</select>
</div>


<div class="field field-invalid">

<label class="field-label" for="doel-fout">Goed doel</label>

<p class="field-error" id="doel-fout-error"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg><span class="visually-hidden">Fout:</span> Kies een goed doel.</p>

<select class="field-input" id="doel-fout" name="doel-fout" aria-describedby="doel-fout-error" aria-invalid="true">
<option value="">Kies…</option>
<option value="voedselbank">Voedselbank Westerveld</option>
<option value="kinderhulp" selected>Stichting Kinderhulp Frederiksoord</option>
</select>
</div>


<div class="field field-check">


<input class="field-checkbox" type="checkbox" id="akkoord" name="akkoord" value="ja" required>

<label class="field-label" for="akkoord">Ik ga akkoord met de voorwaarden <span class="field-required" aria-hidden="true">(verplicht)</span></label>

</div>


<div class="field field-check field-invalid">
<p class="field-error" id="akkoord-fout-error"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg><span class="visually-hidden">Fout:</span> Je moet akkoord gaan om te bestellen.</p>

<input class="field-checkbox" type="checkbox" id="akkoord-fout" name="akkoord-fout" value="ja" aria-describedby="akkoord-fout-error" aria-invalid="true" required>

<label class="field-label" for="akkoord-fout">Ik ga akkoord met de voorwaarden <span class="field-required" aria-hidden="true">(verplicht)</span></label>

</div>


<div class="field field-check">


<input class="field-checkbox" type="checkbox" id="akkoord-uit" name="akkoord-uit" value="ja" checked disabled>

<label class="field-label" for="akkoord-uit">Ik ga akkoord met de voorwaarden</label>

</div>

</div>
</section>

<section class="gallery-section" aria-labelledby="gallery-products">
<h2 id="gallery-products">Producttegels</h2>
<div class="product-grid">

<article class="product-tile">
<h3 class="product-name">Zuurdesemvolkorenbrood met zonnebloempitten</h3>
<p class="product-description">Langzaam gerezen, met een krokante korst.</p>

<span class="price">€ 6,50</span>


